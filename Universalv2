local function showToast(text, color)
    color = color or Color3.fromRGB(70, 130, 255)
    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(0, 260, 0, 44)
    toast.Position = UDim2.new(0.5, -130, 0, -60)
    toast.BackgroundColor3 = Color3.fromRGB(18, 22, 35)
    toast.BackgroundTransparency = 0.1
    toast.BorderSizePixel = 0
    toast.ZIndex = 999
    toast.Parent = player.PlayerGui
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 10) c.Parent = toast
    local s = Instance.new("UIStroke") s.Color = color s.Thickness = 2 s.Parent = toast
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 1000
    lbl.Parent = toast
    TweenService:Create(toast, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -130, 0, 20)
    }):Play()
    task.delay(3, function()
        if not toast or not toast.Parent then return end
        local out = TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -130, 0, -60)
        })
        out:Play()
        out.Completed:Connect(function() if toast then toast:Destroy() end end)
    end)
end

