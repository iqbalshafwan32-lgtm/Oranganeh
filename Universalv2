local hideAllBtn = makePlayerButton("🚫 HIDE ALL PLAYERS • OFF", 21)
local hideAllOn = false
local hideAllConn
local hiddenOriginal = {}
local function hideAllCharacter(char)
    if not char or char == character then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
            if hiddenOriginal[d] == nil then hiddenOriginal[d] = d.Transparency end
            d.Transparency = 1
        end
    end
end
local function restoreAllHidden()
    for obj, t in pairs(hiddenOriginal) do
        if obj and obj.Parent then obj.Transparency = t end
    end
    hiddenOriginal = {}
end
hideAllBtn.MouseButton1Click:Connect(function()
    hideAllOn = not hideAllOn
    hideAllBtn.Text = hideAllOn and "🚫 HIDE ALL • ON" or "🚫 HIDE ALL PLAYERS • OFF"
    hideAllBtn.BackgroundColor3 = hideAllOn and ON_COLOR or BG_BUTTON
    showToast(hideAllOn and "🚫 Player disembunyikan" or "🚫 Player kelihatan",
        hideAllOn and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(255, 80, 80))
    if hideAllOn then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then hideAllCharacter(p.Character) end
        end
        if hideAllConn then hideAllConn:Disconnect() end
        hideAllConn = workspace.DescendantAdded:Connect(function(d)
            if not hideAllOn then return end
            local model = d:FindFirstAncestorOfClass("Model")
            if model and Players:GetPlayerFromCharacter(model) and model ~= character then
                task.wait(0.1)
                hideAllCharacter(model)
            end
        end)
    else
        if hideAllConn then hideAllConn:Disconnect() hideAllConn = nil end
        restoreAllHidden()
    end
end)
table.insert(cleanupFns, function()
    if hideAllConn then hideAllConn:Disconnect() end
    restoreAllHidden()
end)

