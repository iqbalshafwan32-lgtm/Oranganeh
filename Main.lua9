    ["Blessinghalo"] = 1,
    ["Admin"] = 2,
    ["Divine"] = 3,
    ["Eternal"] = 4,
    ["Secret"] = 5,
    ["Cosmic"] = 6,
    ["Mythic"] = 7,
    ["Legendary"] = 8,
    ["Epic"] = 9,
    ["Rare"] = 10,
    ["Uncommon"] = 11,
    ["Common"] = 12
}

local RARITY_COLORS = {
    ["Blessinghalo"] = Color3.fromRGB(255, 215, 0),
    ["Secret"] = Color3.fromRGB(0, 255, 200),
    ["Godly"] = Color3.fromRGB(255, 50, 50),
    ["Mythic"] = Color3.fromRGB(255, 0, 128),
    ["Legendary"] = Color3.fromRGB(255, 170, 0),
    ["Epic"] = Color3.fromRGB(170, 0, 255),
    ["Rare"] = Color3.fromRGB(0, 150, 255),
    ["Uncommon"] = Color3.fromRGB(85, 255, 127),
    ["Common"] = Color3.fromRGB(180, 180, 180)
}

local function getCrateRarity(crateName)
    local lowerName = crateName:lower()
    local sortedRarities = {"blessinghalo", "admin", "divine", "eternal", "secret", "cosmic", "mythic", "legendary", "epic", "rare", "uncommon", "common"}
    for _, rarity in ipairs(sortedRarities) do
        if lowerName:find(rarity) then
            if rarity == "blessinghalo" then return "Blessinghalo"
            elseif rarity == "admin" then return "Admin"
            elseif rarity == "divine" then return "Divine"
            elseif rarity == "eternal" then return "Eternal"
            elseif rarity == "secret" then return "Secret"
            elseif rarity == "cosmic" then return "Cosmic"
            elseif rarity == "mythic" then return "Mythic"
            elseif rarity == "legendary" then return "Legendary"
            elseif rarity == "epic" then return "Epic"
            elseif rarity == "rare" then return "Rare"
            elseif rarity == "uncommon" then return "Uncommon"
            elseif rarity == "common" then return "Common"
            end
        end
    end
    return "Common"
end

local function hasHaloEffect(crate)
    if crate:FindFirstChild("Halo", true) or crate:FindFirstChild("halo", true) then
        return true
    end

    for _, child in ipairs(crate:GetDescendants()) do
        if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Highlight") or child:IsA("PointLight") then
            local name = child.Name:lower()
            if name:find("halo") or name:find("blessing") then
                return true
            end
        end
    end
    return false
end

