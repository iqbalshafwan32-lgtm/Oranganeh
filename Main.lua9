-- Minimize & Close Logic
local isMinimized = false

local function toggleMinimize()
    isMinimized = not isMinimized
    mainFrame.Visible = not isMinimized
    floatToggleBtn.Visible = isMinimized
end

minimizeBtn.MouseButton1Click:Connect(toggleMinimize)
floatToggleBtn.MouseButton1Click:Connect(toggleMinimize)

closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Safe Zone Selector
safeZoneBtn.MouseButton1Click:Connect(function()
    isSelectingSafeZone = true
    safeZoneBtn.Text = "Click anywhere to save location..."
    safeZoneBtn.BackgroundColor3 = Color3.fromRGB(230, 140, 0)
end)

mouse.Button1Down:Connect(function()
    if isSelectingSafeZone then
        isSelectingSafeZone = false
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            safeZoneCFrame = hrp.CFrame
            safeZoneBtn.Text = "✓ Safe Zone Saved!"
            safeZoneBtn.BackgroundColor3 = Color3.fromRGB(35, 160, 80)
        end
    end
end)

-- Steal Action Function (Ngepas & Stabil di Safezone)
local function stealCrate(crate)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    if not safeZoneCFrame then
        safeZoneBtn.Text = "⚠️ Set Safe Zone First!"
        safeZoneBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        task.wait(1)
        safeZoneBtn.Text = "📍 Set Safe Zone: [ Not Set ]"
        safeZoneBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        return false
    end

    if not crate or not crate:IsA("Model") or not crate.PrimaryPart then
        local part = crate:FindFirstChildWhichIsA("BasePart")
        if not part then return false end
        crate.PrimaryPart = part
    end

    isStealingInProgress = true

    if humanoid then
        humanoid.Sit = false
    end
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

    -- 1. Teleport ke Crate
    hrp.CFrame = crate.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
    task.wait(0.15)

    -- Simulasi Proximity Prompt
    for _, child in ipairs(crate:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            fireproximityprompt(child)
        end
    end

    task.wait(0.3)

    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

    -- 2. Teleport kembali ke Safe Zone
    hrp.CFrame = safeZoneCFrame
    
    task.wait(0.5)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

    isStealingInProgress = false
    return true
end

-- Auto Steal Loop Toggle
autoStealBtn.MouseButton1Click:Connect(function()
    isAutoStealActive = not isAutoStealActive
    if isAutoStealActive then
        autoStealBtn.Text = "🤖 Auto Steal: [ ON ]"
        autoStealBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        autoStealBtn.Text = "🤖 Auto Steal: [ OFF ]"
        autoStealBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    end
end)

RunService.RenderStepped:Connect(function()
    local totalPlayers = #Players:GetPlayers()
    local maxPlayers = Players.MaxPlayers
    playerStatLabel.Text = string.format("👤 Players: %d/%d", totalPlayers, maxPlayers)

    local crates = cratesFolder and cratesFolder:GetChildren() or {}
    cratesStatLabel.Text = "📦 Crates: " .. #crates

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local p = hrp.Position
        posStatLabel.Text = string.format("📍 Pos: X: %.0f Y: %.0f Z: %.0f", p.X, p.Y, p.Z)
    end

    fpsStatLabel.Text = string.format("⚡ FPS: %.0f", 1 / RunService.RenderStepped:Wait())
    pingStatLabel.Text = string.format("📶 Ping: %d ms", Stats.Network.ServerStatsItem["Data Ping"]:GetValue())

    if safeZoneCFrame then
        safeDistanceLabel.Text = "🛡 Safe: Set"
        safeDistanceLabel.TextColor3 = Color3.fromRGB(85, 255, 127)
    else
        safeDistanceLabel.Text = "🛡 Safe: Unset"
        safeDistanceLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
    end

    if isAutoStealActive and not isStealingInProgress and safeZoneCFrame then
        for _, crate in ipairs(crates) do
            if crate:IsA("Model") then
                local rarity = getCrateRarity(crate.Name)
                local hasHalo = hasHaloEffect(crate)
                local actualRarity = hasHalo and "Blessinghalo" or rarity
                
                if selectedRarities[actualRarity] then
                    stealCrate(crate)
                    break
                end
            end
        end
    end
end)

-- Populate Crate List UI
local function updateCrateList()
    for _, child in ipairs(scrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    if not cratesFolder then return end

    for _, crate in ipairs(cratesFolder:GetChildren()) do
        if crate:IsA("Model") then
            local rarity = getCrateRarity(crate.Name)
            local hasHalo = hasHaloEffect(crate)
            local displayRarity = hasHalo and "Blessinghalo" or rarity

            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, -6, 0, 36)
            itemFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
            itemFrame.Parent = scrollingFrame

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 6)
            itemCorner.Parent = itemFrame

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(0.6, 0, 1, 0)
            nameLabel.Position = UDim2.new(0, 10, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.TextColor3 = RARITY_COLORS[displayRarity] or Color3.fromRGB(255, 255, 255)
            nameLabel.TextSize = 11
            nameLabel.Font = Enum.Font.GothamSemibold
            nameLabel.Text = crate.Name
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = itemFrame

            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.new(0, 70, 0, 22)
            tpBtn.Position = UDim2.new(1, -78, 0.5, -11)
            tpBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
            tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tpBtn.TextSize = 10
            tpBtn.Font = Enum.Font.GothamBold
            tpBtn.Text = "Steal"
            tpBtn.Parent = itemFrame

            local tpCorner = Instance.new("UICorner")
            tpCorner.CornerRadius = UDim.new(0, 5)
            tpCorner.Parent = tpBtn

            tpBtn.MouseButton1Click:Connect(function()
                stealCrate(crate)
            end)
        end
    end
end

task.spawn(function()
    while true do
        updateCrateList()
        task.wait(1)
    end
end)
