local function updateRarityButtonText()
    if selectedRarities["All"] then
        selectRarityBtn.Text = "🎯 Pilih Rarity: [ All (Selected) ]"
    else
        local count = 0
        local firstName = ""
        for _, r in ipairs(rarityOptions) do
            if selectedRarities[r] then
                count = count + 1
                if firstName == "" then firstName = r end
            end
        end
        if count == 0 then
            selectRarityBtn.Text = "🎯 Pilih Rarity: [ None ]"
        elseif count == 1 then
            selectRarityBtn.Text = "🎯 Pilih Rarity: [ " .. firstName .. " ]"
        else
            selectRarityBtn.Text = "🎯 Pilih Rarity: [ Multi: " .. count .. " Selected ]"
        end
    end
end

-- Tombol Toggle "All" di Dropdown
local allOptBtn = Instance.new("TextButton")
allOptBtn.Size = UDim2.new(1, -8, 0, 26)
allOptBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
allOptBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
allOptBtn.TextSize = 10
allOptBtn.Font = Enum.Font.GothamBold
allOptBtn.Text = "✓ [TOGGLE] All Rarities"
allOptBtn.ZIndex = 11
allOptBtn.Parent = rarityDropdownFrame

local allOptCorner = Instance.new("UICorner")
allOptCorner.CornerRadius = UDim.new(0, 5)
allOptCorner.Parent = allOptBtn

local function refreshAllButtonVisual()
    if selectedRarities["All"] then
        allOptBtn.Text = "✓ [TOGGLE] All Rarities"
        allOptBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    else
        allOptBtn.Text = "✗ [TOGGLE] All Rarities"
        allOptBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    end
end

allOptBtn.MouseButton1Click:Connect(function()
    local newState = not selectedRarities["All"]
    selectedRarities["All"] = newState
    for _, r in ipairs(rarityOptions) do
        selectedRarities[r] = newState
    end
    refreshAllButtonVisual()
    for _, child in ipairs(rarityDropdownFrame:GetChildren()) do
        if child:IsA("TextButton") and child ~= allOptBtn then
            local rName = child.Name
            if selectedRarities[rName] then
                child.Text = "✓ " .. rName
                child.BackgroundColor3 = Color3.fromRGB(40, 90, 50)
            else
                child.Text = "✗ " .. rName
                child.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            end
        end
    end
    updateRarityButtonText()
end)

-- Tombol Opsi Rarity Satuan
for _, rarityName in ipairs(rarityOptions) do
    local optBtn = Instance.new("TextButton")
    optBtn.Name = rarityName
    optBtn.Size = UDim2.new(1, -8, 0, 26)
    optBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 50)
    optBtn.TextColor3 = RARITY_COLORS[rarityName] or Color3.fromRGB(255, 255, 255)
    optBtn.TextSize = 10
    optBtn.Font = Enum.Font.GothamSemibold
    optBtn.Text = "✓ " .. rarityName
    optBtn.ZIndex = 11
    optBtn.Parent = rarityDropdownFrame

    local optCorner = Instance.new("UICorner")
    optCorner.CornerRadius = UDim.new(0, 5)
    optCorner.Parent = optBtn

      optBtn.MouseButton1Click:Connect(function()
        selectedRarities[rarityName] = not selectedRarities[rarityName]
        
        if selectedRarities[rarityName] then
            optBtn.Text = "✓ " .. rarityName
            optBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 50)
        else
            optBtn.Text = "✗ " .. rarityName
            optBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        end

        local allTrue = true
        for _, r in ipairs(rarityOptions) do
            if not selectedRarities[r] then allTrue = false break end
        end
        selectedRarities["All"] = allTrue
        refreshAllButtonVisual()
        updateRarityButtonText()
    end)
end

