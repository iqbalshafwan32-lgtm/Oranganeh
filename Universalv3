-- HIDE ALL
local hideAllBtn = makePlayerButton("🚫 HIDE ALL • OFF", 10)
local hideAllOn = false
local hideAllConn
local hiddenOrig = {}
local function hideChar(char)
    if not char or char == character then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
            if hiddenOrig[d] == nil then hiddenOrig[d] = d.Transparency end
            d.Transparency = 1
        end
    end
end
local function restoreAll()
    for o, t in pairs(hiddenOrig) do if o and o.Parent then o.Transparency = t end end
    hiddenOrig = {}
end
hideAllBtn.MouseButton1Click:Connect(function()
    hideAllOn = not hideAllOn
    hideAllBtn.Text = hideAllOn and "🚫 HIDE ALL • ON" or "🚫 HIDE ALL • OFF"
    hideAllBtn.BackgroundColor3 = hideAllOn and ON_COLOR or BG_BUTTON
    showToast(hideAllOn and "🚫 Hidden" or "🚫 Visible", hideAllOn and GREEN or RED)
    if hideAllOn then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then hideChar(p.Character) end
        end
        hideAllConn = workspace.DescendantAdded:Connect(function(d)
            if not hideAllOn then return end
            local m = d:FindFirstAncestorOfClass("Model")
            if m and Players:GetPlayerFromCharacter(m) and m ~= character then
                task.wait(0.1)
                hideChar(m)
            end
        end)
    else
        if hideAllConn then hideAllConn:Disconnect() hideAllConn = nil end
        restoreAll()
    end
end)

