local function setInvisible(obj)
    if (obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart") or obj:IsA("Decal") then
        if invisOriginal[obj] == nil then invisOriginal[obj] = obj.Transparency end
        obj.Transparency = 1
