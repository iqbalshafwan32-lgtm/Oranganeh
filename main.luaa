-- ===== Jumpscare Task (Muncul setelah 17 detik) =====
task.spawn(function()
    task.wait(17) -- Menunggu 17 detik sesuai permintaan

    local gui = Instance.new("ScreenGui")
    gui.Name = "NeonJumpscare"
    gui.Parent = lp:WaitForChild("PlayerGui")
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 2147483647

    local img = Instance.new("ImageLabel")
    img.Parent = gui
    img.Size = UDim2.new(1, 0, 1, 0)
    img.Image = "rbxassetid://121770493074810"
    img.BackgroundTransparency = 0
    img.BackgroundColor3 = Color3.new(0, 0, 0)
    img.ZIndex = 1
    img.Visible = false

    local flash = Instance.new("Frame")
    flash.Parent = gui
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.new(1, 1, 1)
    flash.BackgroundTransparency = 1
    flash.ZIndex = 2

    local sound = Instance.new("Sound")
    sound.Parent = workspace
    sound.SoundId = "rbxassetid://134262192520482"
    sound.Volume = 10

    game:GetService("ContentProvider"):PreloadAsync({img, sound})

    task.wait(0.3)
    img.Visible = true
    sound:Play()

    local cam = workspace.CurrentCamera
    task.spawn(function()
        for i = 1, 120 do
            cam.CFrame = cam.CFrame * CFrame.new(math.random(-5, 5), math.random(-5, 5), 0)
            
            local mode = math.random(1, 4)
            if mode == 1 then
                flash.BackgroundTransparency = 0.3
                img.ImageColor3 = Color3.new(15, 15, 15)
                img.ImageTransparency = 0
            elseif mode == 2 then
                flash.BackgroundTransparency = 0.6
                img.ImageColor3 = Color3.new(5, 5, 5)
                img.ImageTransparency = 0.2
            elseif mode == 3 then
                flash.BackgroundTransparency = 0.8
                img.ImageColor3 = Color3.new(2, 2, 2)
                img.ImageTransparency = 0.4
            else
                flash.BackgroundTransparency = 1
                img.ImageColor3 = Color3.new(1, 1, 1)
                img.ImageTransparency = 0
            end
            
            task.wait(0.01)
        end
    end)

    task.wait(3)
    gui:Destroy()
    sound:Destroy()
end)

-- ===== State =====
local S = {AutoGrab=false, AutoLoad=true, Rebirth=false, Head=false, Cash=false, UpBrain=false}
local HEAD_AMOUNT, SLOTS = 10, 10
local minRate = 0
local grabDelay = 0.6
local sweepRange, sweepStep = 1500, 300
local busy, loading = false, false
local searchText = ""
local seen, firstScan = {}, true

-- ===== Urutan rarity (sesuai foto) =====
local REVERSE_RARITY = false
local RARITY_ORDER = {"common","uncommon","rare","epic","legendary","mythical","secret","celestial","godly","divine"}
local RARITY_IDX = {}
for i, n in ipairs(RARITY_ORDER) do RARITY_IDX[n] = i end

local function areaRank(name)
	local n = name:lower()
	local isBest = n:find("best", 1, true) and 1 or 0
	n = (n:gsub("best", "")):gsub("[%s_%-]+", "")
	local idx = RARITY_IDX[n] or 99
	return idx * 2 + isBest
end

-- ===== Rate parser =====
local SUF = {k=1e3,m=1e6,b=1e9,t=1e12,qd=1e15,qa=1e15,qn=1e18,qi=1e18,sx=1e21,sp=1e24,oc=1e27,
	no=1e30,dc=1e33,ude=1e36,dde=1e39,tde=1e42,qde=1e45}
local function parseRate(txt)
	txt = tostring(txt or ""):lower():gsub(",", "")
	local num, suf = txt:match("([%d%.]+)%s*(%a*)")
	num = tonumber(num)
	if not num then return 0 end
	return num * (SUF[suf] or 1)
end

-- ===== Muat semua area (streaming) =====
local function streamAll()
	if loading or busy then return end
	if not workspace.StreamingEnabled then return end
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	loading = true
	local origin = root.Position
	local pending = 0
	for x = -sweepRange, sweepRange, sweepStep do
		for z = -sweepRange, sweepRange, sweepStep do
			pending += 1
			task.spawn(function()
				pcall(function()
					lp:RequestStreamAroundAsync(origin + Vector3.new(x, 0, z), 1)
				end)
				pending -= 1
			end)
		end
	end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 8 do task.wait(0.1) end
	loading = false
end

-- ===== Scan =====
local function getHandle(br)
	return br:FindFirstChild("Handle") or br.PrimaryPart
end

local function scan()
	local list, areas, total = {}, {}, 0
	local folder = workspace:FindFirstChild("ActiveBrainrots")
	if not folder then return list, areas, 0 end
	for _, area in ipairs(folder:GetChildren()) do
		for _, br in ipairs(area:GetChildren()) do
			local handle = getHandle(br)
			if handle then
				local g = handle:FindFirstChild("StatsGui")
				local f = g and g:FindFirstChild("Frame")
				local label = f and f:FindFirstChild("Rate")
				local text = label and label.Text or "?"
				total += 1
				areas[area.Name] = (areas[area.Name] or 0) + 1
				if seen[br] == nil then seen[br] = firstScan and 0 or os.clock() end
				list[#list+1] = {model=br, area=area.Name, text=text,
					rate=parseRate(text), t=seen[br]}
			end
		end
	end
	firstScan = false
	table.sort(list, function(a, b) return a.rate > b.rate end)
	return list, areas, total
end

local function grab(model)
	if busy then return false end
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local handle = model and getHandle(model)
	if not (root and handle) then return false end
	busy = true
	local home = root.CFrame
	root.CFrame = handle.CFrame * CFrame.new(0, 3, 0)
	task.wait(0.35)
	local fired = false
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			d.HoldDuration = 0
			pcall(fireproximityprompt, d)
			fired = true
		end
	end
	if not fired and firetouchinterest then
		pcall(function()
			firetouchinterest(root, handle, 0)
			firetouchinterest(root, handle, 1)
		end)
	end
	task.wait(grabDelay)
	root.CFrame = home
	task.wait(0.3)
	busy = false
	return true
end

-- ===== UI helpers =====
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o, r) new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o) end

-- RGB stroke: hanya dipakai di UI utama, tombol $, dan kartu username
local strokes = {}
local function rgb(o, thickness)
	local s = new("UIStroke", {Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Color3.new(1, 1, 1)}, o)
	strokes[#strokes+1] = s
	return s
end
RunService.RenderStepped:Connect(function()
	local t = os.clock() * 0.3
	local i = 1
	while i <= #strokes do
		local s = strokes[i]
		if s.Parent == nil then
			table.remove(strokes, i)
		else
			s.Color = Color3.fromHSV((t + i * 0.08) % 1, 0.9, 1)
			i += 1
		end
	end
end)

