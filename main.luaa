	local row = new("Frame", {Size=UDim2.new(1,-6,0,30), BackgroundColor3=CARD,
		BorderSizePixel=0, LayoutOrder=order}, page)
	corner(row, 7)
	new("TextLabel", {Size=UDim2.new(0.4,0,1,0), Position=UDim2.new(0,8,0,0), BackgroundTransparency=1,
		Text=(rank and ("#" .. rank .. " ") or "") .. it.model.Name, Font=Enum.Font.GothamSemibold,
		TextSize=10, TextColor3=Color3.new(1,1,1), TextXAlignment=Enum.TextXAlignment.Left,
		TextTruncate=Enum.TextTruncate.AtEnd}, row)
	new("TextLabel", {Size=UDim2.new(0.17,0,1,0), Position=UDim2.new(0.42,0,0,0), BackgroundTransparency=1,
		Text=it.area, Font=Enum.Font.Gotham, TextSize=9, TextColor3=GREY,
		TextTruncate=Enum.TextTruncate.AtEnd}, row)
	local pill = new("TextLabel", {Size=UDim2.new(0.25,0,0,18), Position=UDim2.new(0.6,0,0,6),
		BackgroundColor3=BG, Text=it.text, Font=Enum.Font.GothamBold, TextSize=9,
		TextColor3=isNew and GREEN or ACC}, row)
