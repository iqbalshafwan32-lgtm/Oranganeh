-- ===== Render =====
local function render()
	if not main.Visible then return end
	local list, areas, total = scan()
	local areaCount = 0
	for _ in pairs(areas) do areaCount += 1 end
	info.Text = total .. " brainrot | " .. areaCount .. " area" .. (loading and " (memuat...)" or "")
	topLbl.Text = (list[1] and list[1].rate > 0) and ("Top: " .. list[1].text) or "Top: -"

	if current == "LIST" then
		clear(listPage)
		local shown = 0
		for _, it in ipairs(list) do
			if matches(it) and shown < 60 then
				shown += 1
				brainrotRow(listPage, it, shown, shown, false)
			end
		end
	elseif current == "LIVE BRAINROT" then
		clear(livePage)
		local names = {}
		for n in pairs(areas) do names[#names+1] = n end
		table.sort(names, function(a, b)
			local ra, rb = areaRank(a), areaRank(b)
			if ra ~= rb then
				if REVERSE_RARITY then return ra > rb end
				return ra < rb
			end
			return a < b
		end)
		local order = 0
		for _, n in ipairs(names) do
			local group = {}
			for _, it in ipairs(list) do
				if it.area == n then group[#group+1] = it end
			end
			if #group > 0 then
				order += 1
				new("TextLabel", {Size=UDim2.new(1,-6,0,18), BackgroundTransparency=1, LayoutOrder=order,
					Text="■ " .. n .. "  (" .. #group .. ")", Font=Enum.Font.GothamBold, TextSize=10,
					TextColor3=ACC, TextXAlignment=Enum.TextXAlignment.Left}, livePage)
				table.sort(group, function(a, b) return a.t > b.t end)
				for _, it in ipairs(group) do
					order += 1
					local isNew = it.t > 0 and (os.clock() - it.t) < 15
					brainrotRow(livePage, it, nil, order, isNew)
				end
			end
		end
	end
end

listSearch:GetPropertyChangedSignal("Text"):Connect(function()
	searchText = listSearch.Text:lower()
	pcall(render)
end)

-- ===== Drag =====
local function makeDraggable(handle, target)
	local dragging, dStart, sPos
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dStart, sPos = true, i.Position, target.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dStart
			target.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
		end
	end)
end
makeDraggable(sideHead, main)
makeDraggable(tabTitle, main)

showTab("LIST")

-- ===== Loops =====
task.spawn(function()
	while gui.Parent do
		if S.AutoLoad then pcall(streamAll) end
		task.wait(6)
	end
end)

task.spawn(function()
	while gui.Parent do
		pcall(render)
		task.wait(2)
	end
end)

task.spawn(function()
	while gui.Parent do
		if S.AutoGrab and not busy and not loading then
			local list = scan()
			for _, it in ipairs(list) do
				if it.rate > 0 and it.rate >= minRate then
					sub.Text = "grab: " .. it.model.Name
					grab(it.model)
					break
				end
			end
		else
			sub.Text = loading and "memuat area..." or (S.AutoGrab and "auto grab: menunggu..." or "status: idle")
		end
		task.wait(1)
	end
end)

task.spawn(function()
	while gui.Parent do
		if S.Rebirth then pcall(function() RF:WaitForChild("Rebirth"):InvokeServer() end) end
		task.wait(2)
	end
end)

task.spawn(function()
	while gui.Parent do
		if S.Head then pcall(function() RF:WaitForChild("UpgradeHeadSize"):InvokeServer(HEAD_AMOUNT) end) end
		task.wait(1)
	end
end)

task.spawn(function()
	while gui.Parent do
		if S.Cash then
			for i = 1, SLOTS do
				pcall(function() RE:WaitForChild("CollectMoney"):FireServer("Slot" .. i) end)
			end
		end
		task.wait(1)
	end
end)

task.spawn(function()
	while gui.Parent do
		if S.UpBrain then
			for i = 1, SLOTS do
				pcall(function() RF:WaitForChild("UpgradeBrainrot"):InvokeServer("Slot" .. i) end)
			end
		end
		task.wait(1.5)
	end
end)
