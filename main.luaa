-- ===== Tabs =====
local pages, tabBtns, current = {}, {}, "LIST"
local listSearch

local function showTab(name)
	current = name
	tabTitle.Text = name
	for n, p in pairs(pages) do p.Visible = (n == name) end
	for n, b in pairs(tabBtns) do
		b.BackgroundColor3 = (n == name) and CARD or SIDE
		b.TextColor3 = (n == name) and ACC or Color3.fromRGB(200,204,220)
	end
end

local function makeTab(name, withSearch)
	local b = new("TextButton", {Size=UDim2.new(1,0,0,32), BackgroundColor3=SIDE, Text="   " .. name,
		Font=Enum.Font.GothamSemibold, TextSize=11, TextColor3=Color3.fromRGB(200,204,220),
		TextXAlignment=Enum.TextXAlignment.Left, AutoButtonColor=false}, tabHolder)
	corner(b, 8)

	local holder = content
	local scrollPos, scrollSize = UDim2.new(0,0,0,0), UDim2.new(1,0,1,0)
	local container
	if withSearch then
		container = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Visible=false}, content)
		listSearch = new("TextBox", {Size=UDim2.new(1,-6,0,26), BackgroundColor3=CARD, Text="",
			PlaceholderText="Cari nama brainrot...", Font=Enum.Font.Gotham, TextSize=10,
			TextColor3=Color3.new(1,1,1), PlaceholderColor3=GREY, ClearTextOnFocus=false}, container)
		corner(listSearch, 7)
		holder = container
		scrollPos, scrollSize = UDim2.new(0,0,0,32), UDim2.new(1,0,1,-32)
	end

	local p = new("ScrollingFrame", {Size=scrollSize, Position=scrollPos, BackgroundTransparency=1,
		BorderSizePixel=0, ScrollBarThickness=3, AutomaticCanvasSize=Enum.AutomaticSize.Y,
		CanvasSize=UDim2.new(0,0,0,0), Visible = withSearch and true or false}, holder)
	new("UIListLayout", {Padding=UDim.new(0,5), SortOrder=Enum.SortOrder.LayoutOrder}, p)
	pages[name], tabBtns[name] = (container or p), b
	b.MouseButton1Click:Connect(function() showTab(name) end)
	return p
end

local listPage = makeTab("LIST", true)
local livePage = makeTab("LIVE BRAINROT")
local farmPage = makeTab("FARM")

local function clear(page)
	for _, c in ipairs(page:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

local function matches(it)
	return searchText == "" or it.model.Name:lower():find(searchText, 1, true) ~= nil
end

