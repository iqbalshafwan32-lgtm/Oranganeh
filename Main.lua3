ServerListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    ServerListScroll.CanvasSize = UDim2.new(0, 0, 0, ServerListLayout.AbsoluteContentSize.Y + 6)
end)

local cachedServers = {}

local function fetchServers()
    StatusLbl.Text = "Status:\nFetching... 🟡"
    for _, child in pairs(ServerListScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local success, res = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)

    if success and res then
        local decoded = HttpService:JSONDecode(res)
        if decoded and decoded.data then
            cachedServers = decoded.data
            for i, server in ipairs(decoded.data) do
                if i > 25 then break end

                local item = Instance.new("Frame", ServerListScroll)
                item.Size = UDim2.new(1, -6, 0, 24)
                item.BackgroundColor3 = Color3.fromRGB(22, 30, 48)
                Instance.new("UICorner", item).CornerRadius = UDim.new(0, 4)

                local pCount = Instance.new("TextLabel", item)
                pCount.Size = UDim2.new(0.55, 0, 1, 0)
                pCount.Position = UDim2.new(0, 6, 0, 0)
                pCount.Text = "👥 " .. tostring(server.playing) .. "/" .. tostring(server.maxPlayers)
                pCount.TextColor3 = Color3.fromRGB(180, 200, 230)
                pCount.Font = Enum.Font.GothamBold
                pCount.TextSize = 9
                pCount.TextXAlignment = Enum.TextXAlignment.Left
                pCount.BackgroundTransparency = 1

                local joinBtn = Instance.new("TextButton", item)
                joinBtn.Size = UDim2.new(0.4, 0, 0.8, 0)
                joinBtn.Position = UDim2.new(0.57, 0, 0.1, 0)
                joinBtn.BackgroundColor3 = Color3.fromRGB(100, 110, 240)
                joinBtn.Text = "Join"
                joinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                joinBtn.Font = Enum.Font.GothamBold
                joinBtn.TextSize = 9
                Instance.new("UICorner", joinBtn).CornerRadius = UDim.new(0, 4)

                joinBtn.MouseButton1Click:Connect(function()
                    StatusLbl.Text = "Status:\nTeleporting... 🚀"
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                end)
            end
            StatusLbl.Text = "Status:\nReady 🟢"
        end
    else
        StatusLbl.Text = "Status:\nFetch Failed 🔴"
    end
end

RefreshBtn.MouseButton1Click:Connect(fetchServers)

HopBtn.MouseButton1Click:Connect(function()
    StatusLbl.Text = "Status:\nHopping Filter... 🚀"
    if #cachedServers > 0 then
        local found = false
        for _, s in ipairs(cachedServers) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                local pass = false
                
                -- LOGIKA FILTER PEMAIN
                if SelectedFilter == "ALL" then
                    pass = true
                elseif SelectedFilter == "LOW" then
                    pass = (s.playing >= 1 and s.playing <= 3)
                elseif SelectedFilter == "MID" then
                    pass = (s.playing >= 4 and s.playing <= 7)
                elseif SelectedFilter == "HIGH" then
                    pass = (s.playing >= 8)
                end

                if pass then
                    found = true
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                    break
                end
            end
        end
        
        if not found and SelectedFilter ~= "ALL" then
            for _, s in ipairs(cachedServers) do
                if s.id ~= game.JobId and s.playing > 1 and s.playing < s.maxPlayers then
                    found = true
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                    break
                end
            end
        end

        if not found then
            StatusLbl.Text = "Status:\nFilter Kosong! ⚠"
        end
    else
        fetchServers()
    end
end)

RejoinBtn.MouseButton1Click:Connect(function()
    StatusLbl.Text = "Status:\nRejoining... 🔄"
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end)

RandomBtn.MouseButton1Click:Connect(function()
    StatusLbl.Text = "Status:\nRandom Hop... 🎲"
    if #cachedServers > 0 then
        local randServer = cachedServers[math.random(1, #cachedServers)]
        if randServer and randServer.id then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, randServer.id, LocalPlayer)
        end
    else
        fetchServers()
    end
end)

task.spawn(fetchServers)

-- ================= TAB 3: PLAYER =================
addActionButton(PlayerPage, "📍 SAVE POSITION", "✅ POSITION SAVED!", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        SavedCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
    end
end)

addActionButton(PlayerPage, "🌀 TELEPORT SAVED", "✅ TELEPORT SUCCESS!", function()
    if SavedCFrame and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = SavedCFrame
    end
end)

addActionButton(PlayerPage, "💀 RESET CHARACTER", "✅ RESET SUCCESS!", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.Health = 0
    end
end)
