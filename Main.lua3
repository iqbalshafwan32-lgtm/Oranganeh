-- List khusus untuk UIStroke Pelangi (Hanya Frame Hub & Header)
local rainbowStrokes = {}

local function addRainbowBorder(instance, thickness)
    local stroke = Instance.new("UIStroke", instance)
    stroke.Thickness = thickness or 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    table.insert(rainbowStrokes, stroke)
    return stroke
end

-- Loop Animasi Pelangi RGB
local hue = 0
RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.3) % 1
    local rainbowColor = Color3.fromHSV(hue, 1, 1)
    for _, stroke in ipairs(rainbowStrokes) do
        if stroke and stroke.Parent then
            stroke.Color = rainbowColor
        end
    end
end)

