local Container = Instance.new("Frame", MainFrame)
Container.Size = UDim2.new(1, -20, 1, -96)
Container.Position = UDim2.new(0, 10, 0, 90)
Container.BackgroundTransparency = 1

local pages = {}
local function createPage(name)
    local page = Instance.new("ScrollingFrame", Container)
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 3
    page.Visible = false
    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
    end)
    pages[name] = page
    return page
end

local FarmPage = createPage("FARM")
local ServerPage = createPage("SERVER")
local PlayerPage = createPage("PLAYER")

local tabBtns = {}
local function switchTab(name)
    for tName, page in pairs(pages) do
        page.Visible = (tName == name)
        if tabBtns[tName] then
            tabBtns[tName].BackgroundColor3 = (tName == name) and Color3.fromRGB(60, 100, 220) or Color3.fromRGB(22, 30, 48)
        end
    end
end

for _, tabName in ipairs({"FARM", "SERVER", "PLAYER"}) do
    local btn = Instance.new("TextButton", TabFrame)
    btn.Size = UDim2.new(0.315, 0, 1, 0)
    btn.Text = (tabName == "FARM" and "⚡ FARM" or (tabName == "SERVER" and "🌐 SERVER" or "👤 PLAYER"))
    btn.BackgroundColor3 = Color3.fromRGB(22, 30, 48)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function() switchTab(tabName) end)
    tabBtns[tabName] = btn
end

switchTab("FARM")

-- Component Helpers
local itemOrder = 0

local function createSettingBox(parent, labelText, defaultVal, onInputChanged)
    itemOrder = itemOrder + 1
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(20, 28, 44)
    frame.LayoutOrder = itemOrder
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 210, 230)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1

    local box = Instance.new("TextBox", frame)
    box.Size = UDim2.new(0.35, -5, 0.8, 0)
    box.Position = UDim2.new(0.65, 0, 0.1, 0)
    box.Text = tostring(defaultVal)
    box.BackgroundColor3 = Color3.fromRGB(13, 17, 28)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 11
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        local num = tonumber(box.Text)
        if num then onInputChanged(num) end
    end)
end

local function createToggleBtn(parent, iconName, defaultOn, onToggle)
    itemOrder = itemOrder + 1
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(20, 28, 44)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = itemOrder
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local state = defaultOn
    local clickThread = nil

    local function updateText()
        btn.Text = "  " .. iconName .. " - " .. (state and "ON" or "OFF")
        btn.TextColor3 = state and Color3.fromRGB(52, 211, 153) or Color3.fromRGB(245, 100, 100)
    end
    updateText()

    btn.MouseButton1Click:Connect(function()
        state = not state
        
        btn.Text = "  " .. iconName .. " -> " .. (state and "ENABLED!" or "DISABLED!")
        btn.TextColor3 = Color3.fromRGB(255, 215, 0)
        
        if clickThread then task.cancel(clickThread) end
        clickThread = task.delay(0.15, function()
            updateText()
        end)

        onToggle(state)
    end)
end

local function addActionButton(parent, iconText, activeText, cb)
    itemOrder = itemOrder + 1
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.Text = "  " .. iconText
    btn.BackgroundColor3 = Color3.fromRGB(20, 28, 44)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = itemOrder
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local clickThread = nil
    btn.MouseButton1Click:Connect(function()
        btn.Text = "  " .. activeText
        btn.TextColor3 = Color3.fromRGB(52, 211, 153)

        cb()

        if clickThread then task.cancel(clickThread) end
        clickThread = task.delay(0.15, function()
            btn.Text = "  " .. iconText
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)
    end)
end

