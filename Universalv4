    invisOn = not invisOn
    invisBtn.Text = invisOn and "👻 INVISIBLE • ON" or "👻 INVISIBLE • OFF"
    invisBtn.BackgroundColor3 = invisOn and ON_COLOR or BG_BUTTON
    applyInvisible()
    showToast(invisOn and "👻 Invis ON" or "👻 Invis OFF", invisOn and COL_GREEN or COL_RED)
end)

