-- Cari folder crate (Otomatis)
local cratesFolder = Workspace:WaitForChild("Crates", 3)
if not cratesFolder then
    for _, child in ipairs(Workspace:GetChildren()) do
        local nameLower = child.Name:lower()
        if nameLower:find("crate") or nameLower:find("loot") or nameLower:find("chest") then
            cratesFolder = child
            break
        end
    end
end

if not cratesFolder then
    warn("⚠️ Gagal menemukan folder Crate/Loot! Script dihentikan.")
    return
end

-- Rarity Config
local RARITY_ORDER = {
    ["Blessinghalo"] = 1, ["Admin"] = 2, ["Divine"] = 3, ["Eternal"] = 4,
    ["Secret"] = 5, ["Cosmic"] = 6, ["Mythic"] = 7, ["Legendary"] = 8,
    ["Epic"] = 9, ["Rare"] = 10, ["Uncommon"] = 11, ["Common"] = 12
}

local RARITY_COLORS = {
    ["Blessinghalo"] = Color3.fromRGB(255, 215, 0),
    ["Admin"] = Color3.fromRGB(255, 60, 60),
    ["Divine"] = Color3.fromRGB(255, 245, 180),
    ["Eternal"] = Color3.fromRGB(120, 255, 255),
    ["Secret"] = Color3.fromRGB(0, 255, 200),
    ["Cosmic"] = Color3.fromRGB(140, 90, 255),
    ["Mythic"] = Color3.fromRGB(255, 0, 128),
    ["Legendary"] = Color3.fromRGB(255, 170, 0),
    ["Epic"] = Color3.fromRGB(170, 0, 255),
    ["Rare"] = Color3.fromRGB(0, 150, 255),
    ["Uncommon"] = Color3.fromRGB(85, 255, 127),
    ["Common"] = Color3.fromRGB(180, 180, 180)
}

local RARITY_LIST = {}
for name, _ in pairs(RARITY_ORDER) do table.insert(RARITY_LIST, name) end
table.sort(RARITY_LIST, function(a, b) return RARITY_ORDER[a] < RARITY_ORDER[b] end)

local function getCrateRarity(crateName)
    local lowerName = crateName:lower()
    for _, rarity in ipairs(RARITY_LIST) do
        if lowerName:find(rarity:lower()) then return rarity end
    end
    return "Common"
end

local function hasHaloEffect(crate)
    if crate:FindFirstChild("Halo", true) or crate:FindFirstChild("halo", true) then return true end
    for _, child in ipairs(crate:GetDescendants()) do
        if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Highlight") or child:IsA("PointLight") then
            local n = child.Name:lower()
            if n:find("halo") or n:find("blessing") or n:find("yellow") then return true end
        end
        if child:IsA("BasePart") and child.Name:lower():find("halo") then return true end
    end
    return false
end

