-- Tabs
local tabs = {}
local pageMap = {}

local function makeTab(name, icon, y, pageFrame)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 36)
    btn.Position = UDim2.new(0, 8, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.BackgroundTransparency = 1
    btn.AutoButtonColor = false
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.TextColor3 = GREY
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Text = "   " .. icon .. "  " .. name
    btn.Parent = sidebar
    corner(btn, 8)

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 18)
    indicator.Position = UDim2.new(0, 2, 0.5, -9)
    indicator.BackgroundColor3 = ACCENT
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.Parent = btn
    corner(indicator, 2)

    tabs[name] = { btn = btn, ind = indicator }
    pageMap[name] = pageFrame

    btn.MouseButton1Click:Connect(function()
        for n, t in pairs(tabs) do
            local active = (n == name)
            t.ind.Visible = active
            t.btn.BackgroundTransparency = active and 0 or 1
            t.btn.BackgroundColor3 = active and Color3.fromRGB(50, 50, 65) or Color3.fromRGB(40, 40, 50)
            t.btn.TextColor3 = active and WHITE or GREY
            pageMap[n].Visible = active
        end
    end)
end

