local chips = {}
local function styleChip(r)
    local c = chips[r]
    if selectedRarities[r] then
        c.BackgroundColor3 = RARITY_COLORS[r]
        c.TextColor3 = Color3.fromRGB(0,0,0)
    else
        c.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        c.TextColor3 = RARITY_COLORS[r]
    end
end

for _, r in ipairs(RARITY_LIST) do
    local btn = Instance.new("TextButton")
    btn.Text = r
    btn.TextSize = 9
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = rarityContainer
    corner(btn, 4)
    chips[r] = btn
    styleChip(r)
    btn.MouseButton1Click:Connect(function()
        selectedRarities[r] = not selectedRarities[r]
        styleChip(r)
    end)
end

-- Steal Function ====================
local function stealCrate(crate, btn)
    if isStealing then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not safeZoneCFrame then
        if btn then 
            btn.Text = "Set Safezone!" 
            task.delay(1, function() if btn then btn.Text = "Steal" end end) 
        end
        return
    end
    
    isStealing = true
    if btn then 
        btn.Text = "Processing..." 
        btn.BackgroundColor3 = Color3.fromRGB(200, 150, 0) 
    end

    local target = crate:IsA("Model") and (crate.PrimaryPart or crate:FindFirstChildWhichIsA("BasePart")) or crate
    if target then
        hrp.CFrame = target.CFrame * CFrame.new(0, 0, 1.5)
        task.wait(1.2)
        if crate.Parent then
            for _, p in ipairs(crate:GetDescendants()) do
                if p:IsA("ProximityPrompt") then 
                    p.HoldDuration = 0
                    pcall(function() fireproximityprompt(p) end) 
                end
            end
        end
        task.wait(0.8)
        if character and character:FindFirstChild("HumanoidRootPart") then 
            character.HumanoidRootPart.CFrame = safeZoneCFrame 
        end
    end

    isStealing = false
    if btn then
        btn.Text = "Done!" 
        btn.BackgroundColor3 = GREEN
        task.wait(1)
        if btn then 
            btn.Text = "Steal" 
            btn.BackgroundColor3 = Color3.fromRGB(40, 100, 200) 
        end
    end
end

-- ==================== REFRESH LIST UI ====================
local function refreshCrateList()
    for _, child in ipairs(scrollList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local list = {}
    local bestRank = 99
    bestName = "None"

    for _, crate in ipairs(cratesFolder:GetChildren()) do
        local part = crate:IsA("Model") and (crate.PrimaryPart or crate:FindFirstChildWhichIsA("BasePart")) or crate
        if part then
            local rar = getCrateRarity(crate.Name)
            local halo = hasHaloEffect(crate) or rar == "Blessinghalo"
            local rank = halo and 0 or (RARITY_ORDER[rar] or 99)
            if halo then rar = "Blessinghalo" end
            if rank < bestRank then 
                bestRank = rank
                bestName = rar 
            end
            table.insert(list, { Crate = crate, Rarity = rar, Rank = rank, Halo = halo })
        end
    end

    table.sort(list, function(a, b) return a.Rank < b.Rank end)
    crateListCache = list
    crateCount = #list

    for i, item in ipairs(list) do
        local row = Instance.new("Frame")
        row.LayoutOrder = i
        row.Size = UDim2.new(1, 0, 0, 34)
        row.BackgroundColor3 = PANEL_BG
        row.BorderSizePixel = 0
        row.Parent = scrollList
        corner(row, 6)
        stroke(row, LINE_COLOR, 0.3)

        -- Color Indicator
        local ind = Instance.new("Frame")
        ind.Size = UDim2.new(0, 4, 1, -8)
        ind.Position = UDim2.new(0, 6, 0, 4)
        ind.BackgroundColor3 = RARITY_COLORS[item.Rarity] or WHITE
        ind.BorderSizePixel = 0
        ind.Parent = row
        corner(ind, 2)

        -- Name Label
        newLabel(row, item.Crate.Name .. " [" .. item.Rarity .. "]", 11, Enum.Font.GothamSemibold, WHITE, UDim2.new(0, 16, 0, 0), UDim2.new(1, -100, 1, 0))

        -- Action Button (Uniform Size)
        local actBtn = newButton(row, "Steal", 10, Color3.fromRGB(40, 100, 200), UDim2.new(1, -84, 0, 4), UDim2.new(0, 74, 1, -8))
        
        if item.Halo then
            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0, 6, 0, 6)
            dot.Position = UDim2.new(0, 4, 0.5, -3)
            dot.BackgroundColor3 = GOLD
            dot.BorderSizePixel = 0
            dot.Parent = actBtn
            corner(dot, 3)
        end

        actBtn.MouseButton1Click:Connect(function()
            stealCrate(item.Crate, actBtn)
        end)
    end
end

-- ==================== STATS LOOP ====================
local frameCount = 0
local lastTime = tick()

RunService.RenderStepped:Connect(function()
    frameCount += 1
    local now = tick()
    if now - lastTime >= 1 then
        local ok, ping = pcall(function() 
            return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) 
        end)
        
        statsLabel.Text = string.format("Ping: %sms | FPS: %d | Crates: %d | Best: %s", 
            ok and tostring(ping) or "--", 
            frameCount, crateCount, bestName)
        
        if safeZoneCFrame and character and character:FindFirstChild("HumanoidRootPart") then
            local dist = math.floor((character.HumanoidRootPart.Position - safeZoneCFrame.Position).Magnitude)
            safeStatus.Text = "Status: Aktif (Jarak: " .. dist .. "m)"
            safeStatus.TextColor3 = GREEN
        else
            safeStatus.Text = "Status: Belum diset"
            safeStatus.TextColor3 = GREY
        end
        
        frameCount = 0
        lastTime = now
    end
end)

-- ==================== INITIALIZATION ====================
local function setTab(name) 
    for n, t in pairs(tabs) do
        local active = (n == name)
        t.ind.Visible = active
        t.btn.BackgroundTransparency = active and 0 or 1
        t.btn.BackgroundColor3 = active and Color3.fromRGB(50, 50, 65) or Color3.fromRGB(40, 40, 50)
        t.btn.TextColor3 = active and WHITE or GREY
        pageMap[n].Visible = active
    end
end

-- Set default tab and load data
setTab("List")
refreshCrateList()

-- Auto refresh when crates spawn or despawn
cratesFolder.ChildAdded:Connect(refreshCrateList)
cratesFolder.ChildRemoved:Connect(refreshCrateList)

print("✅ Crate Hub Loaded - Klik logo $ untuk membuka UI!")
