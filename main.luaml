statusHint.TextWrapped = true

local function countSelected()
    local n = 0
    for _, v in pairs(selectedRarities) do if v then n = n + 1 end end
    return n
end

local function makeToggle(parent, yPos, callback)
    local track = Instance.new("TextButton")
    track.Size = UDim2.new(0, 44, 0, 24)
    track.Position = UDim2.new(1, -56, 0, yPos)
    track.Text = ""
    track.AutoButtonColor = false
    track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    track.Parent = parent
    corner(track, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = UDim2.new(0, 2, 0, 2)
    knob.BackgroundColor3 = WHITE
    knob.Parent = track
    corner(knob, 10)

    local state = false
    track.MouseButton1Click:Connect(function()
        local nextS = not state
        if callback(nextS) ~= false then
            state = nextS
            TweenService:Create(track, TweenInfo.new(0.2), { BackgroundColor3 = state and ACCENT or Color3.fromRGB(60, 60, 70) }):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), { Position = state and UDim2.new(1, -22, 0, 2) or UDim2.new(0, 2, 0, 2) }):Play()
        end
    end)
end

makeToggle(autoCard, 8, function(v)
    if v then
        if not safeZoneCFrame then statusHint.Text = "⚠️ Set Safe Zone dulu!" statusHint.TextColor3 = Color3.fromRGB(255, 80, 80) return false end
        if countSelected() == 0 then statusHint.Text = "⚠️ Pilih Rarity dulu!" statusHint.TextColor3 = Color3.fromRGB(255, 80, 80) return false end
        autoSteal = true
        statusHint.Text = "✅ Auto Steal Aktif"
        statusHint.TextColor3 = GREEN
        task.spawn(function()
            while autoSteal do
                if not isStealing and safeZoneCFrame then
                    for _, item in ipairs(crateListCache) do
                        if selectedRarities[item.Rarity] and item.Crate and item.Crate.Parent and (not attempted[item.Crate] or tick() - attempted[item.Crate] > 8) then
                            attempted[item.Crate] = tick()
                            local hrp = character and character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                isStealing = true
                                local target = item.Crate:IsA("Model") and (item.Crate.PrimaryPart or item.Crate:FindFirstChildWhichIsA("BasePart")) or item.Crate
                                hrp.CFrame = target.CFrame * CFrame.new(0,0,1.5)
                                task.wait(1.2)
                                if item.Crate.Parent then
                                    for _, p in ipairs(item.Crate:GetDescendants()) do
                                        if p:IsA("ProximityPrompt") then p.HoldDuration = 0; pcall(function() fireproximityprompt(p) end) end
                                    end
                                end
                                task.wait(0.8)
                                if character and character:FindFirstChild("HumanoidRootPart") then character.HumanoidRootPart.CFrame = safeZoneCFrame end
                                isStealing = false
                            end
                            break
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    else
        autoSteal = false
        statusHint.Text = "Auto Steal Mati"
        statusHint.TextColor3 = GREY
    end
    return true
end)

